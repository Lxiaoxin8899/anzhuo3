<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 中文注释：云备份排除密钥、管理员状态和本地数据库。 -->
        <exclude domain="sharedpref" path="web_server_prefs.xml" />
        <exclude domain="sharedpref" path="wireless_transfer_prefs.xml" />
        <exclude domain="sharedpref" path="device_identity_prefs.xml" />
        <exclude domain="database" path="smartdosing.db" />
        <exclude domain="database" path="smartdosing.db-wal" />
        <exclude domain="database" path="smartdosing.db-shm" />
        <exclude domain="file" path="datastore/admin_preferences.preferences_pb" />
        <exclude domain="file" path="datastore/operator_identity.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- 中文注释：设备迁移同样不搬运认证密钥和本地业务库。 -->
        <exclude domain="sharedpref" path="web_server_prefs.xml" />
        <exclude domain="sharedpref" path="wireless_transfer_prefs.xml" />
        <exclude domain="sharedpref" path="device_identity_prefs.xml" />
        <exclude domain="database" path="smartdosing.db" />
        <exclude domain="database" path="smartdosing.db-wal" />
        <exclude domain="database" path="smartdosing.db-shm" />
        <exclude domain="file" path="datastore/admin_preferences.preferences_pb" />
        <exclude domain="file" path="datastore/operator_identity.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
